* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: #050505;
    color: white;
}

/* ENCABEZADO Y NAVEGACIÓN MEJORADA */
header {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 2px solid #087cff;
    padding: 12px 4%;
}

.header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 15px;
}

.logo-header img {
    height: 45px;
    object-fit: contain;
    transition: transform 0.3s ease;
}

.logo-header img:hover {
    transform: scale(1.05);
}

nav {
    display: flex;
    align-items: center;
    gap: 20px; /* Separación garantizada entre enlaces */
    flex-wrap: wrap;
}

nav a {
    color: #e0e0e0;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    position: relative;
    padding: 6px 4px;
    transition: color 0.3s ease;
    white-space: nowrap;
}

nav a::after {
    content: '';
    position: absolute;
    width: 0%;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: #087cff;
    transition: width 0.3s ease;
}

nav a:hover {
    color: #087cff;
}

nav a:hover::after {
    width: 100%;
}


/* PORTADA / HERO CON LOGO LLAMATIVO */
.inicio {
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    background: radial-gradient(circle at center, #001f44 0%, #00050e 100%);
}

.hero-content {
    max-width: 800px;
    width: 100%;
}

.logo-hero {
    width: 80%;
    max-width: 320px;
    height: auto;
    margin-bottom: 20px;
    filter: drop-shadow(0 0 20px rgba(8, 124, 255, 0.6));
    animation: flotar 4s ease-in-out infinite;
}

@keyframes flotar {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

.inicio h1 {
    font-size: 52px;
    letter-spacing: 2px;
    font-weight: 900;
}

.inicio h1 span {
    color: #087cff;
    text-shadow: 0 0 15px rgba(8, 124, 255, 0.5);
}

.tagline {
    color: #40a9ff;
    letter-spacing: 5px;
    margin: 10px 0 20px;
    font-weight: bold;
    font-size: 14px;
}

.inicio h2 {
    margin-bottom: 30px;
    font-weight: 300;
    color: #ddd;
    font-size: 20px;
}

.boton-hero {
    background: linear-gradient(45deg, #087cff, #005dcc);
    color: white;
    padding: 16px 35px;
    text-decoration: none;
    border-radius: 30px;
    font-weight: bold;
    display: inline-block;
    box-shadow: 0 0 15px rgba(8, 124, 255, 0.4);
    transition: all 0.3s ease;
}

.boton-hero:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 25px rgba(8, 124, 255, 0.8);
}


/* SECCIÓN JUEGOS */
.seccion-juegos {
    padding: 20px 5%;
}

.titulo {
    text-align: center;
    color: #1688ff;
    font-size: 32px;
    margin: 40px 0 30px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.juegos {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
}

.tarjeta {
    background: #0d131d;
    width: 270px;
    padding: 15px;
    text-align: center;
    border: 1px solid #173b67;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
}

.tarjeta:hover {
    transform: translateY(-5px);
    border-color: #087cff;
    box-shadow: 0 8px 20px rgba(8, 124, 255, 0.3);
}

.tarjeta img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px;
}

.tarjeta h3 {
    margin: 15px 0 8px;
    font-size: 18px;
}

/* DESCRIPCIÓN CON VER MÁS */
.descripcion {
    color: #aaa;
    font-size: 13px;
    line-height: 1.4;
    margin-bottom: 8px;
    text-align: left;
    transition: all 0.3s ease;
}

.descripcion-corta {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.btn-ver-mas {
    background: transparent;
    color: #087cff;
    border: none;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    margin-bottom: 12px;
    text-decoration: underline;
    align-self: center;
    padding: 5px 10px;
}

.btn-ver-mas:hover {
    color: #40a9ff;
}

.tarjeta-footer {
    margin-top: auto;
}

.tarjeta h4 {
    color: #1688ff;
    font-size: 20px;
    margin: 10px 0;
}

.btn-comprar {
    background: #087cff;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    width: 100%;
    transition: background 0.3s ease;
}

.btn-comprar:hover {
    background: #005dcc;
}


/* RECARGAS */
.recargas {
    background: #080f17;
    text-align: center;
    padding: 40px 20px;
    margin-top: 50px;
}

.texto {
    color: #bbb;
    margin-bottom: 30px;
}

.formulario {
    background: #111;
    width: 400px;
    max-width: 100%;
    margin: auto;
    padding: 30px;
    border: 1px solid #087cff;
    border-radius: 10px;
}

.formulario label {
    display: block;
    text-align: left;
    margin-top: 15px;
    margin-bottom: 7px;
    font-size: 14px;
}

.formulario input,
.formulario select {
    width: 100%;
    padding: 12px;
    background: #222;
    color: white;
    border: 1px solid #444;
    border-radius: 5px;
    outline: none;
}

.formulario input:focus,
.formulario select:focus {
    border-color: #087cff;
}

.formulario button {
    width: 100%;
    margin-top: 25px;
    background: #087cff;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
}


/* EMPRESA */
.empresa {
    background: #050505;
    padding: 40px 20px;
}

.informacion {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
    max-width: 1100px;
    margin: 0 auto;
}

.informacion div {
    width: 300px;
    padding: 25px;
    background: #101820;
    border-left: 4px solid #087cff;
    border-radius: 0 8px 8px 0;
}

.informacion h2 {
    color: #1688ff;
    margin-bottom: 15px;
    font-size: 20px;
}

.informacion p {
    color: #ccc;
    line-height: 1.6;
    font-size: 14px;
}


/* CONTACTO Y FOOTER */
.contacto {
    text-align: center;
    padding: 50px 20px;
}

.contacto h2 {
    color: #087cff;
    font-size: 32px;
    margin-bottom: 15px;
}

.contacto p {
    color: #ccc;
    margin: 8px;
}

footer {
    background: #000;
    text-align: center;
    padding: 20px;
    color: #777;
    border-top: 1px solid #111;
}


/* RESPONSIVO PARA TELÉFONOS */
@media (max-width: 768px) {
    .header-container {
        justify-content: center;
    }

    nav {
        justify-content: center;
        gap: 12px;
        width: 100%;
    }

    nav a {
        font-size: 14px;
        padding: 4px 8px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 4px;
    }

    .inicio h1 {
        font-size: 38px;
    }

    .tagline {
        letter-spacing: 3px;
        font-size: 12px;
    }

    .inicio h2 {
        font-size: 16px;
    }

    .tarjeta {
        width: 100%;
        max-width: 330px;
    }

    .informacion div {
        width: 100%;
    }
}
